# Copie para .env (ou rode scripts/gen-dev-secrets.sh, que gera valores aleatórios).
# NUNCA versione o .env: ele contém segredos.
# Formato .properties (sem aspas, sem "export").

# ---- Portas / emissor ----
AS_PORT=9443
APP_PORT=8443
AS_ISSUER=https://localhost:9443

# ---- TLS (keystore autoassinado de dev, compartilhado pelos dois apps) ----
TLS_KEYSTORE_PATH=secrets/tls/localhost.p12
TLS_KEYSTORE_PASSWORD=troque-me
TLS_TRUSTSTORE_PATH=secrets/tls/truststore.p12
TLS_TRUSTSTORE_PASSWORD=troque-me

# ---- Chave de assinatura RS256 do Servidor de Autorização ----
AS_SIGNING_KID=2026-11
AS_SIGNING_KEY_PATH=secrets/keys/signing-2026-11.pem
# Durante rotação: chave anterior continua publicada no /jwks.json
AS_PREVIOUS_KID=
AS_PREVIOUS_PUBLIC_KEY_PATH=

# ---- Cliente cadastrado (usado pelos DOIS componentes) ----
OIDC_CLIENT_ID=app-cybersecurity-33506
OIDC_CLIENT_SECRET=troque-me
OIDC_REDIRECT_URI=https://localhost:8443/callback

# ---- Usuários de demonstração (seed do Servidor de Autorização) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=troque-me
SEED_USER_USERNAME=aluno
SEED_USER_PASSWORD=troque-me
